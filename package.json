{
  "name": "fasting-tracker-webmcp",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --local",
    "build": "vite build",
    "preview": "wrangler dev --local",
    "preview:ui": "vite --host 127.0.0.1 --mode ui-preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "node scripts/create-auth-secrets.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply fasting-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply fasting-tracker --remote",
    "db:migrate:demo:local": "wrangler d1 migrations apply fasting-tracker-demo --local --config wrangler.demo.jsonc",
    "db:migrate:demo:remote": "wrangler d1 migrations apply fasting-tracker-demo --remote --config wrangler.demo.jsonc",
    "db:seed:demo:local": "wrangler d1 execute fasting-tracker-demo --local --config wrangler.demo.jsonc --file scripts/seed-demo.sql",
    "db:seed:demo:remote": "wrangler d1 execute fasting-tracker-demo --remote --config wrangler.demo.jsonc --file scripts/seed-demo.sql",
    "preview:demo": "npm run build && wrangler dev --local --config wrangler.demo.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "deploy:demo": "npm run build && wrangler deploy --config wrangler.demo.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "agents": "0.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.18.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.3"
  }
}
