/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Origin-Agent-Cluster: ?1
  Permissions-Policy: tools=(self), camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600
